# Supabase. En local salen de `npx supabase status`; en la nube, de
# Project Settings -> API del proyecto waldorf-dev.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# La service_role key NO va aqui. Ninguna ruta que atienda peticiones de
# usuarios puede usarla: el aislamiento entre escuelas lo hace la RLS y la
# service_role la saltaria por completo. Ver CLAUDE.md, regla 3.
